<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MultiAgentes</RootNamespace>
    <!-- O Agent Framework ainda publica APIs marcadas como experimentais.
         Sem isso o build falha com MEAI001. -->
    <NoWarn>$(NoWarn);MEAI001;CS1591</NoWarn>
    <UserSecretsId>4accd307-eff3-4ef9-987a-b02ac2dc7e9a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Agentes e workflow -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.17.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />

    <!-- Provedor do modelo. GeminiDotnet repassa o JSON Schema das tools sem
         regerar, que e o que faz function calling funcionar com o Gemini. -->
    <PackageReference Include="GeminiDotnet.Extensions.AI" Version="0.25.0" />

    <!-- Host, configuracao e segredos -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="11.0.0-preview.7.26381.103" />
  </ItemGroup>

</Project>
